{
  "name": "@eyevanovich/picm-factory",
  "version": "0.5.2",
  "description": "PiCM workspace and coding-context tools for Pi and Claude Code.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eyevanovich/picm-factory.git"
  },
  "homepage": "https://github.com/eyevanovich/picm-factory#readme",
  "bugs": {
    "url": "https://github.com/eyevanovich/picm-factory/issues"
  },
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "picm",
    "icm",
    "folder-architecture",
    "monorepo",
    "codebase-context",
    "agent-skills"
  ],
  "pi": {
    "extensions": [
      "./pi/extensions"
    ],
    "skills": [],
    "prompts": []
  },
  "scripts": {
    "check": "npm run typecheck && node --test test/*.test.mjs && node scripts/check-package.mjs",
    "typecheck": "tsc --noEmit",
    "build:claude": "node scripts/build-claude-bundle.mjs",
    "report:instructions": "npm run build:claude && node scripts/report-instructions.mjs",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "pi/extensions",
    "pi/HOST.md",
    "pi/session-history.md",
    "shared/compose-instructions.ts",
    "shared/runtime",
    "shared/picm-factory"
  ],
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
